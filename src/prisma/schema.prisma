model User {
  id            String      @id @default(cuid())
  username      String      @unique
  email         String      @unique
  passwordHash  String
  createdAt     DateTime    @default(now())
}


model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  userId    String
  user      User @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}